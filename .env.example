# Opcional — analytics (evita cargar scripts rotos en producción)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=1234567890

# URL pública del sitio (sin barra final). Obligatoria para que reset de contraseña y OAuth no apunten a localhost
# cuando pides el enlace desde npm run dev. En Netlify: https://casamagari.com
# VITE_PUBLIC_SITE_URL=https://casamagari.com

# Supabase (obligatorio para productos y solicitudes de vendors)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Admin panel (must match Supabase is_magari_admin() after RLS migration)
# VITE_MAGARI_ADMIN_EMAIL=magaribyelena@gmail.com

# Supabase para funciones de servidor (Rewards, checkout con cupones). Obligatorio para Magari Rewards.
# En Netlify: Site settings → Environment variables. En local: añade a .env (no subas .env a git).
# La service_role key está en Supabase → Project settings → API → service_role (secret).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Stripe (Netlify → Environment variables). PUBLIC_SITE_URL = URL canónica del sitio (éxito/cancel checkout).
# STRIPE_SECRET_KEY=sk_live_...
# PUBLIC_SITE_URL=https://casamagari.com
# Webhook Stripe → https://TU_DOMINIO/.netlify/functions/stripe-webhook (evento checkout.session.completed)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Resend: correos de pedido pagado (cliente + magaribyelena@gmail.com) desde processShopPaidSession.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Magari & Co. <hello@casamagari.com>

# Email: Resend vía Netlify (ver EMAIL_SETUP.md). En local, apunta al dominio desplegado:
# VITE_EMAIL_RELAY_URL=https://casamagari.com/.netlify/functions/send-magari-mail
# Opcional — misma idea para aprobación/rechazo vendor si probas desde local:
# VITE_VENDOR_EMAIL_RELAY_URL=https://casamagari.com/.netlify/functions/send-vendor-email
