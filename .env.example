# Supabase (obligatorio para productos y solicitudes de vendors)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Supabase para funciones de servidor (Rewards, checkout con cupones). Obligatorio para Magari Rewards.
# En Netlify: Site settings → Environment variables. En local: añade a .env (no subas .env a git).
# La service_role key está en Supabase → Project settings → API → service_role (secret).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# EmailJS (obligatorio para que lleguen correos a magaribyelena@gmail.com y a clientes)
# Crear cuenta en https://www.emailjs.com/ y plantilla con To: {{to_email}}, Subject: {{subject}}, Content: {{message}}
# Ver EMAIL_SETUP.md
VITE_EMAILJS_SERVICE_ID=tu_service_id
VITE_EMAILJS_TEMPLATE_ID=tu_template_id
VITE_EMAILJS_PUBLIC_KEY=tu_public_key
